# Copy to .env and set private values. Never commit .env.
POSTGRES_DB=rbpo2026
POSTGRES_ADMIN_USER=rbpo_admin
POSTGRES_ADMIN_PASSWORD=replace_with_a_long_random_admin_password
DB_USERNAME=rbpo_app
DB_PASSWORD=replace_with_a_different_long_random_password
DB_URL=jdbc:postgresql://localhost:5432/rbpo2026
SERVER_PORT=8080

# Optional bootstrap accounts. Use unique strong passwords; never commit real values.
APP_ADMIN_NAME=System Administrator
APP_ADMIN_EMAIL=admin@example.test
APP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_ADMIN_PASSWORD_2026!
APP_STAFF_NAME=Residence Staff
APP_STAFF_EMAIL=staff@example.test
APP_STAFF_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_STAFF_PASSWORD_2026!
