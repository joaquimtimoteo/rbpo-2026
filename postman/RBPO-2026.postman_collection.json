  "item": [
    {
      "name": "Security — Task 4",
      "item": [
        {
          "name": "1. Get CSRF token (run first)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/csrf",
            "description": "Run first. Postman cookie jar keeps JSESSIONID; test script stores the token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"csrfToken\", body.token);",
                  "pm.test(\"CSRF token returned\", () => pm.expect(body.token).to.be.a(\"string\").and.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Register student (no role field allowed)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrfToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Task Four Student\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/register",
            "description": "Use a unique email. Registration always assigns STUDENT."
          }
        },
        {
          "name": "3. Current account (student should succeed)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{studentEmail}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{studentPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/me"
          }
        },
        {
          "name": "4. Student forbidden from CRUD (expect 403)",
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{studentEmail}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{studentPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/rooms",
            "description": "Expected result: 403 Forbidden; the student role cannot access administrative CRUD."
          }
        },
        {
          "name": "5. Staff can read rooms",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/rooms",
            "description": "Uses collection-level STAFF Basic Auth. Set staffEmail/staffPassword to the bootstrap account."
          }
        },
        {
          "name": "6. Missing CSRF token (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Should Fail\",\n  \"email\": \"csrf-fail@example.test\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/users",
            "description": "Expected result: 403 because X-CSRF-TOKEN is missing."
          }
        }
      ]
    },
